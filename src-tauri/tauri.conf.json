{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MHAutoUpdateCompilerNext",
  "mainBinaryName": "MHAutoUpdateCompilerNext",
  "version": "../package.json",
  "identifier": "com.sharkgao.solutionbat.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "MHAutoUpdateCompilerNext",
      "label": "main",
      "width": 1320,
      "height": 920,
      "minWidth": 760,
      "minHeight": 600,
      "center": true,
      "backgroundColor": "#f7f8fa"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Unreal Engine build workspace manager",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false } }
  }
}
